<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.atur256.webimageinterop</groupId>
    <artifactId>web-image-interop</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>web-image-interop</name>
    <description>Java wrappers for JavaScript global objects using GraalVM WebImage API</description>
    <url>https://github.com/atur256/web-image-interop</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>atur256</id>
            <name>Arthur Schwaiger</name>
            <email>- </email> <!-- TODO: replace this -->
            <url>https://github.com/atur256</url>
        </developer>
    </developers>

    <scm> <!-- TODO: check this -->
        <connection>scm:git:https://github.com/atur256/web-image-interop.git</connection>
        <developerConnection>scm:git:https://github.com/atur256/web-image-interop.git</developerConnection>
        <url>https://github.com/atur256/web-image-interop</url>
    </scm>

    <properties> <!-- TODO: check this -->
        <maven.compiler.source>22</maven.compiler.source>
        <maven.compiler.target>22</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- JUnit 5 API -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>6.0.0-RC3</version>
            <scope>test</scope>
        </dependency>

        <!-- GraalVM WebImage Interop (replace with central version when available) -->
        <dependency> <!-- TODO: replace this -->
            <groupId>com.graalvm.webimage</groupId>
            <artifactId>webimage-preview</artifactId>
            <version>21.0.0</version>
        </dependency>

        <!-- GraalVM SDK and native image support -->
        <dependency>
            <groupId>com.graalvm.nativeimage</groupId>
            <artifactId>nativeimage-libgraal</artifactId>
            <version>21.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.graalvm.sdk</groupId>
            <artifactId>sdk-test</artifactId>
            <version>21.0.0</version>
        </dependency>

        <!-- JetBrains annotations -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>RELEASE</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>22</source>
                    <target>22</target>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Surefire plugin for running tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

            <!-- Attach sources -->
            <plugin> <!-- TODO: check this -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.2.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Attach Javadocs -->
            <plugin> <!-- TODO: check this -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- GPG signing -->
            <plugin> <!-- TODO: replace this -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement> <!-- TODO: check this -->
        <repository>
            <id>ossrh</id>
            <name>OSSRH Repository</name>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
        <snapshotRepository>
            <id>ossrh-snapshots</id>
            <name>OSSRH Snapshot Repository</name>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots/</url>
        </snapshotRepository>
    </distributionManagement>
</project>
